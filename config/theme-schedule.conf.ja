# theme-schedule の設定（~/.local/bin/theme-schedule が読む）

# 切り替え方: auto（時刻で自動）か manual（手動）
# メニューの Appearance → Light/Dark か、theme-schedule auto / manual で変えられる
MODE=manual

# 明るい版にする時刻と、暗い版にする時刻（HH:MM）
LIGHT_AT=07:00
DARK_AT=18:00

# 名前の決まり（<名前>-light と <名前>）で組にならないテーマを書く。
# 1行に「明るい版 暗い版」の順で、テーマのフォルダ名を書く。
PAIRS=(
  "catppuccin-latte catppuccin"
)
